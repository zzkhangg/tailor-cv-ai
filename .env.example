POSTGRES_DB=tailorcv
POSTGRES_USER=tailorcv
POSTGRES_PASSWORD=change-this-local-password
JAVA_PORT=8080
FRONTEND_PORT=3000
AI_CONNECT_TIMEOUT_MS=2000
AI_READ_TIMEOUT_MS=5000
AI_PROCESSING_READ_TIMEOUT_MS=45000
